# ─── Airflow ───
AIRFLOW__CORE__EXECUTOR=LocalExecutor 
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgr es/airflow
AIRFLOW__CORE__FERNET_KEY= 
AIRFLOW__CORE__LOAD_EXAMPLES=False 
AIRFLOW__WEBSERVER__SECRET_KEY=change_me

# ─── OpenSky Network API ───
OPENSKY_CLIENT_ID=your_client_id 
OPENSKY_CLIENT_SECRET=your_client_secret

# ─── PostgreSQL Database (Sostituto di Snowflake) ───
POSTGRES_HOST=tuo_host_postgres
POSTGRES_PORT=5432
POSTGRES_USER=tuo_utente
POSTGRES_PASSWORD=tua_password
POSTGRES_DB=tuo_database
POSTGRES_SCHEMA=RAW
